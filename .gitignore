# =============================================================================
# NEXUS-ABI .gitignore
# =============================================================================

# Virtual environment — never commit this (300MB+, machine-specific)
venv/
.venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Raw data — large CSVs go in .gitignore (use DVC or note in README)
01_data_pipeline/raw/*.csv
01_data_pipeline/raw/*.parquet

# Cleaned parquet output (regenerated by spark_cleaner.py)
01_data_pipeline/cleaned/

# Trained model files (regenerated by train_churn.py)
02_predictive_core/models/*.pkl
02_predictive_core/models/*.json

# ChromaDB vector store (regenerated by RAG ingestion)
04_agentic_engine/vectorstore/

# Environment secrets
.env
*.env

# Personal notes — never commit
UNDERSTANDING.md

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.code-workspace

# Logs
*.log
logs/

# Spark temp files
spark-warehouse/
derby.log
metastore_db/

# Power BI (binary — track separately if needed)
05_dashboard/*.pbix
